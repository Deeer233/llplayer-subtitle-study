diff --git a/LLPlayer/Controls/StudySubtitleEditor.cs b/LLPlayer/Controls/StudySubtitleEditor.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e8e5929d120b475062c955e8a8a7a76e549a1754
--- /dev/null
+++ b/LLPlayer/Controls/StudySubtitleEditor.cs
@@ -0,0 +1,62 @@
+using System.Globalization;
+using System.Windows;
+using System.Windows.Automation;
+using System.Windows.Controls;
+using System.Windows.Data;
+
+namespace LLPlayer.Controls;
+
+public sealed class StudySubtitleTextConverter : IMultiValueConverter
+{
+    public object Convert(object[] values, Type targetType, object parameter, CultureInfo culture)
+        => values[0] is StudyTextOverride correction && values[1] is string raw && values[2] is int index
+            && index == correction.Index && Services.StudyDialogue.Normalize(raw) == correction.Cue
+            ? correction.Text : values[1] as string ?? "";
+
+    public object[] ConvertBack(object value, Type[] targetTypes, object parameter, CultureInfo culture)
+        => throw new NotSupportedException();
+}
+
+internal sealed record StudyTextOverride(int Index, string Cue, string Text);
+
+internal sealed class StudySubtitleEditor : Window
+{
+    internal StudySubtitleEditor(Window? owner, string english, Action replay, Action<string?, bool> save)
+    {
+        if (owner is not null) Owner = owner;
+        Title = "核对本句英文";
+        WindowStartupLocation = owner is null ? WindowStartupLocation.CenterScreen : WindowStartupLocation.CenterOwner;
+        ShowInTaskbar = false;
+        Width = 500;
+        SizeToContent = SizeToContent.Height;
+        ResizeMode = ResizeMode.NoResize;
+
+        var panel = new StackPanel { Margin = new Thickness(16) };
+        var text = new TextBox { Text = english, MaxLength = 1000, MinHeight = 64, MaxHeight = 160,
+            TextWrapping = TextWrapping.Wrap, AcceptsReturn = true, VerticalScrollBarVisibility = ScrollBarVisibility.Auto, Padding = new Thickness(6) };
+        AutomationProperties.SetName(text, "本句英文");
+        var feedback = new TextBlock { TextWrapping = TextWrapping.Wrap, Margin = new Thickness(0, 6, 0, 0) };
+        var buttons = new WrapPanel { Margin = new Thickness(0, 8, 0, 0) };
+        void Button(string label, Action action, bool cancel = false)
+        {
+            var button = new Button { Content = label, Padding = new Thickness(10, 4, 10, 4), Margin = new Thickness(0, 0, 6, 0), IsCancel = cancel };
+            button.Click += (_, _) => action();
+            buttons.Children.Add(button);
+        }
+        void Commit(bool skip)
+        {
+            try { save(text.Text, skip); DialogResult = true; }
+            catch (Exception error) when (error is System.IO.IOException or UnauthorizedAccessException or System.IO.InvalidDataException or System.Text.Json.JsonException)
+            { feedback.Text = error.Message; }
+        }
+        Button("重听本句", replay);
+        Button("跳过本句", () => Commit(true));
+        Button("保存并标为已核对", () => Commit(false));
+        Button("取消", () => { }, cancel: true);
+        panel.Children.Add(text);
+        panel.Children.Add(feedback);
+        panel.Children.Add(buttons);
+        Content = panel;
+        Loaded += (_, _) => text.Focus();
+    }
+}
