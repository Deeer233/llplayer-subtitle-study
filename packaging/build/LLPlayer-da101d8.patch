+++ b/LLPlayer/Services/StudySubtitleAccess.cs
@@ -0,0 +1,39 @@
+using FlyleafLib.MediaFramework.MediaStream;
+using FlyleafLib.MediaPlayer;
+
+namespace LLPlayer.Services;
+
+internal static class StudySubtitleAccess
+{
+    internal static void OpenSimplifiedChinese(Player player)
+    {
+        if (player.Subtitles.Streams?.FirstOrDefault(IsSimplifiedChinese) is { } chinese)
+            player.Commands.OpenSubtitles.Execute(((object)"1", (object)chinese, (object)SelectSubMethod.Original));
+    }
+
+    private static bool IsSimplifiedChinese(SubtitlesStream stream)
+    {
+        if (stream.IsBitmap || stream.Language?.ISO6391 != "zh") return false;
+        return stream.Language.CultureName is "zh-CN" or "zh-Hans" or "zh-SG"
+            || (stream.Title?.Contains("Simplified", StringComparison.OrdinalIgnoreCase) ?? false)
+            || (stream.Title?.Contains("简体", StringComparison.Ordinal) ?? false);
+    }
+
+    internal static (StudyCue[] Cues, int Index) EnglishWindow(Player player)
+    {
+        if (player.IsOpening || player.SubtitlesManager[0].LanguageSource?.ISO6391 != "en") return ([], -1);
+        var (items, current) = player.SubtitlesManager[0].GetStudyWindow(16);
+        if (current < 0 || !items[current].IsText || items[current].IsBitmap) return ([], -1);
+        return (items.Select(s => new StudyCue(s.StartTime, s.EndTime, s.IsText && !s.IsBitmap ? s.Text ?? "" : "")).ToArray(), current);
+    }
+
+    internal static string? ChineseFor(Player player, StudyDialogue line)
+    {
+        var manager = player.SubtitlesManager[1];
+        if (manager.LanguageSource?.ISO6391 != "zh") return null;
+        var delay = TimeSpan.FromTicks(player.Config.Subtitles[1].Delay - player.Config.Subtitles[0].Delay);
+        var items = manager.GetStudyCuesStartingInRange(line.Start - StudyDialogue.ChineseLead - delay, line.End - delay);
+        return line.MatchChinese(items.Where(s => s.IsText && !s.IsBitmap)
+            .Select(s => new StudyCue(s.StartTime + delay, s.EndTime + delay, s.Text!)).ToArray());
+    }
+}
diff --git a/LLPlayer/Services/StudySubtitleNotes.cs b/LLPlayer/Services/StudySubtitleNotes.cs
new file mode 100644
index 0000000000000000000000000000000000000000..d943f02770e84e9ae5f155eb1184a5b98f56959e
--- /dev/null
+++ b/LLPlayer/Services/StudySubtitleNotes.cs
@@ -0,0 +1,87 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+namespace LLPlayer.Services;
+
+internal sealed record StudySubtitleTrack(string Media, string Source, int Stream);
+internal enum StudyCheck { Unchecked, Confirmed, Corrected, Skipped }
+internal sealed record StudySubtitleNote(StudyCheck Check, string? English = null);
+internal sealed record StudySubtitleLine(StudyDialogue Original, StudyDialogue Dialogue, StudyCheck Check)
+{
+    internal bool Skipped => Check == StudyCheck.Skipped;
+    internal bool UseReference => Check is not (StudyCheck.Corrected or StudyCheck.Skipped);
+}
+
+internal sealed class StudySubtitleNotes(string file)
+{
+    private Dictionary<string, StudySubtitleNote> _notes = Read(file);
+
+    internal static string? FileIdentity(string? input)
+    {
+        if (string.IsNullOrEmpty(input)) return null;
+        if (!Path.IsPathFullyQualified(input) && Uri.TryCreate(input, UriKind.Absolute, out var uri) && uri.IsFile)
+            input = uri.LocalPath;
+        if (!Path.IsPathFullyQualified(input) || input.StartsWith("\\\\", StringComparison.Ordinal)) return null;
+        try
+        {
+            var info = new FileInfo(input);
+            return info.Exists ? $"{info.FullName.ToUpperInvariant()}\n{info.Length}\n{info.LastWriteTimeUtc.Ticks}" : null;
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException) { return null; }
+    }
+
+    private static string Key(StudySubtitleTrack track, StudyDialogue line)
+        => Convert.ToHexString(SHA256.HashData(JsonSerializer.SerializeToUtf8Bytes(
+            new { track, Start = line.Start.Ticks, End = line.End.Ticks, Text = StudyDialogue.Normalize(line.Text) })));
+
+    internal StudySubtitleLine Resolve(StudySubtitleTrack? track, StudyDialogue original)
+    {
+        if (track is null || _notes.Count == 0 || !_notes.TryGetValue(Key(track, original), out var note))
+            return new(original, original, StudyCheck.Unchecked);
+        return new(original, note.Check == StudyCheck.Corrected ? original with { Text = note.English! } : original, note.Check);
+    }
+
+    internal void Save(StudySubtitleTrack track, StudyDialogue original, string? english, bool skip)
+    {
+        var text = StudyDialogue.NormalizeForStudy(english ?? "");
+        if (!skip && (text.Length is 0 or > 1000 || !text.Any(char.IsAsciiLetter)))
+            throw new InvalidDataException("英文原句需包含英文字母，且不能超过 1,000 个字符。");
+        StudySubtitleNote note = skip ? new(StudyCheck.Skipped) : text == original.Text ? new(StudyCheck.Confirmed) : new(StudyCheck.Corrected, text);
+        var folder = Path.GetDirectoryName(file)!;
+        Directory.CreateDirectory(folder);
+        using var guard = File.Open(file + ".lock", FileMode.OpenOrCreate, FileAccess.Write, FileShare.None);
+        var latest = Read(file);
+        latest[Key(track, original)] = note;
+        var temp = Path.Combine(folder, Guid.NewGuid().ToString("N") + ".tmp");
+        var created = false;
+        try
+        {
+            using (var output = File.Open(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            {
+                created = true;
+                JsonSerializer.Serialize(output, latest);
+                output.Flush(flushToDisk: true);
+            }
+            File.Move(temp, file, overwrite: true);
+            _notes = latest;
+        }
+        finally
+        {
+            if (created && File.Exists(temp)) File.Delete(temp);
+        }
+    }
+
+    private static Dictionary<string, StudySubtitleNote> Read(string path)
+    {
+        if (!File.Exists(path)) return [];
+        var notes = JsonSerializer.Deserialize<Dictionary<string, StudySubtitleNote>>(File.ReadAllBytes(path));
+        if (notes is null || notes.Values.Any(note => note is null || !Enum.IsDefined(note.Check)
+            || (note.Check == StudyCheck.Corrected && string.IsNullOrWhiteSpace(note.English))))
+            throw new InvalidDataException("字幕核对记录格式不正确。");
+        return notes;
+    }
+}
diff --git a/LLPlayer/Services/StudyTranslationQueue.cs b/LLPlayer/Services/StudyTranslationQueue.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a7ef76e237efc250847f7f31a345639fb2f9b031
--- /dev/null
+++ b/LLPlayer/Services/StudyTranslationQueue.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace LLPlayer.Services;
+
+// Owned by the UI dispatcher; tests supply their own synchronization context or await each settled request.
+internal sealed class StudyTranslationQueue(Func<StudyDialogue, CancellationToken, Task<string?>> translate, Action updated)
+{
+    private readonly record struct Key(TimeSpan Start, TimeSpan End, string Text)
+    {
+        internal static Key Of(StudyDialogue line) => new(line.Start, line.End, line.Text);
+    }
+
+    private readonly Dictionary<Key, string?> _cache = new();
+    private StudyDialogue[] _plan = [];
+    private CancellationTokenSource? _request;
+    private Key? _active;
+    private bool _running;
+
+    internal string? Find(StudyDialogue line) => _cache.GetValueOrDefault(Key.Of(line));
+    internal bool Pending(StudyDialogue line) => !_cache.ContainsKey(Key.Of(line)) && _plan.Any(l => Key.Of(l) == Key.Of(line));
+
+    internal static StudyDialogue[] Plan(StudySubtitleLine current, string? reference,
+        IEnumerable<StudySubtitleLine> upcoming, Func<StudySubtitleLine, string?> findReference, bool includeUpcoming)
+    {
+        var plan = new List<StudyDialogue>(3);
+        if (!current.Skipped && reference is null) plan.Add(current.Dialogue);
+        if (!includeUpcoming) return plan.ToArray();
+
+        var seen = new HashSet<Key> { Key.Of(current.Dialogue) };
+        foreach (var next in upcoming)
+        {
+            if (next.Dialogue.Start > current.Dialogue.End + TimeSpan.FromSeconds(25)) break;
+            if (!seen.Add(Key.Of(next.Dialogue)) || next.Skipped || findReference(next) is not null) continue;
+            plan.Add(next.Dialogue);
+            if (plan.Count == 3) break;
+        }
+        return plan.ToArray();
+    }
+
+    internal void Prepare(IEnumerable<StudyDialogue> lines, bool retryFailed = false)
+    {
+        _plan = lines.DistinctBy(Key.Of).Take(3).ToArray();
+        if (retryFailed && _plan.FirstOrDefault() is { } current && _cache.TryGetValue(Key.Of(current), out var result) && result is null)
+            _cache.Remove(Key.Of(current));
+        var next = Next();
+        if (_active is { } active && (next is null || Key.Of(next) != active)) _request?.Cancel();
+        if (next is not null && !_running) _ = Run();
+    }
+
+    internal void Reset()
+    {
+        Prepare([]);
+        _cache.Clear();
+    }
+
+    private StudyDialogue? Next() => _plan.FirstOrDefault(l => !_cache.ContainsKey(Key.Of(l)));
+
+    private async Task Run()
+    {
+        _running = true;
+        try
+        {
+            while (Next() is { } line)
+            {
+                using var request = new CancellationTokenSource();
+                _request = request;
+                var key = Key.Of(line);
+                _active = key;
+                try
+                {
+                    var value = await translate(line, request.Token);
+                    if (!request.IsCancellationRequested)
+                    {
+                        if (_cache.Count >= 96) _cache.Remove(_cache.Keys.First());
+                        _cache[key] = value;
+                    }
+                }
+                catch (OperationCanceledException) when (request.IsCancellationRequested) { }
+                finally { _request = null; _active = null; }
+                if (!request.IsCancellationRequested) updated();
+            }
+        }
+        finally { _running = false; }
+    }
+}
