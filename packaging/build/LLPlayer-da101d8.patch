diff --git a/LLPlayer/Services/StudyDialogue.cs b/LLPlayer/Services/StudyDialogue.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3e7c01711f6ca01fcc9dd8c67dff9c663374e8b3
--- /dev/null
+++ b/LLPlayer/Services/StudyDialogue.cs
@@ -0,0 +1,110 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace LLPlayer.Services;
+
+internal sealed record StudyCue(TimeSpan Start, TimeSpan End, string Text);
+
+internal sealed record StudyDialogue(TimeSpan Start, TimeSpan End, string Text, string[] Before, string[] After)
+{
+    internal static readonly TimeSpan ChineseLead = TimeSpan.FromMilliseconds(500);
+    private static readonly Regex SplitSpeaker = new(@"(^|\n)\s*[-–—]\s*(?:(?:\.{3}|\u2026)\s*)?\p{L}");
+    private static readonly Regex SpeakerBoundary = new(@"\r\n|[\r\n]");
+    private static readonly Regex TurnStart = new(@"^\s*[-–—]\s*(?=(?:(?:\.{3}|\u2026)\s*)?\p{L})");
+    private static readonly Regex EndsSentence = new(@"[.!?\u2026][\s\x22'’”]*$");
+    private static readonly Regex EndContinuation = new(@"(?:\.{3}|\u2026)\s*$");
+    private static readonly Regex StartContinuation = new(@"^\s*(?:\.{3}|\u2026)\s*(?=[a-z])");
+
+    internal static string Normalize(string text) => Regex.Replace(text.Trim(), @"\s+", " ");
+
+    internal static string NormalizeForStudy(string text)
+    {
+        var lines = SpeakerBoundary.Split(text).Where(line => !string.IsNullOrWhiteSpace(line)).ToArray();
+        var starts = lines.Select((line, i) => (line, i)).Where(item => TurnStart.IsMatch(item.line)).Select(item => item.i).ToArray();
+        if (starts.Length < 2 || starts[0] != 0) return Normalize(text);
+        return string.Join("\n", starts.Select((start, i) => Normalize(string.Join(" ", lines[start..(i + 1 < starts.Length ? starts[i + 1] : lines.Length)]))));
+    }
+
+    internal StudyDialogue[] SpeakerTurns()
+    {
+        var parts = NormalizeForStudy(Text).Split('\n');
+        if (parts.Length == 1) return [this];
+        var spoken = parts.Select(part => TurnStart.Replace(part, "")).ToArray();
+        return spoken.Select((text, i) => this with
+        {
+            Text = text,
+            Before = Before.Concat(spoken.Take(i)).TakeLast(2).ToArray(),
+            After = spoken.Skip(i + 1).Concat(After).Take(2).ToArray()
+        }).ToArray();
+    }
+
+    internal StudyDialogue? ContextForTarget(string target)
+    {
+        target = Normalize(target);
+        if (target.Length == 0) return null;
+        var turns = SpeakerTurns();
+        if (turns.Length == 1) return turns[0];
+        var pattern = $@"(?<![\p{{L}}\p{{N}}]){Regex.Escape(target)}(?![\p{{L}}\p{{N}}])";
+        var matching = turns.Where(turn => Regex.IsMatch(turn.Text, pattern, RegexOptions.IgnoreCase | RegexOptions.CultureInvariant)).Take(2).ToArray();
+        return matching.Length == 1 ? matching[0] : null;
+    }
+
+    internal async Task<string?> TranslateTurns(Func<StudyDialogue, CancellationToken, Task<string?>> translate, CancellationToken token)
+    {
+        var turns = SpeakerTurns();
+        if (turns.Length == 1) return await translate(turns[0], token);
+        var result = new List<string>(turns.Length);
+        foreach (var turn in turns)
+        {
+            token.ThrowIfCancellationRequested();
+            var text = await translate(turn, token);
+            if (string.IsNullOrWhiteSpace(text)) return null;
+            result.Add("- " + text);
+        }
+        return string.Join("\n", result);
+    }
+
+    private static bool Continues(StudyCue left, StudyCue right)
+        => right.Start >= left.Start && right.Start - left.End <= TimeSpan.FromMilliseconds(650)
+            && right.Start - left.End >= TimeSpan.FromMilliseconds(-150)
+            && !string.IsNullOrWhiteSpace(left.Text)
+            && !SplitSpeaker.IsMatch(left.Text) && !SplitSpeaker.IsMatch(right.Text)
+            && (PairedContinuation(left, right) || !EndsSentence.IsMatch(left.Text)
+                && right.Text.TrimStart().FirstOrDefault() is >= 'a' and <= 'z');
+
+    private static bool PairedContinuation(StudyCue left, StudyCue right)
+        => EndContinuation.IsMatch(left.Text) && StartContinuation.IsMatch(right.Text);
+
+    internal static StudyDialogue Build(IReadOnlyList<StudyCue> cues, int current)
+    {
+        var first = current;
+        var last = current;
+        while (first > 0 && last - first < 3 && Continues(cues[first - 1], cues[first])) first--;
+        while (last + 1 < cues.Count && last - first < 3 && Continues(cues[last], cues[last + 1])) last++;
+        var pieces = new string[last - first + 1];
+        for (var i = first; i <= last; i++)
+        {
+            var piece = cues[i].Text;
+            if (i > first && PairedContinuation(cues[i - 1], cues[i])) piece = StartContinuation.Replace(piece, "");
+            if (i < last && PairedContinuation(cues[i], cues[i + 1])) piece = EndContinuation.Replace(piece, "");
+            pieces[i - first] = piece;
+        }
+        return new StudyDialogue(cues[first].Start, cues[last].End,
+            NormalizeForStudy(string.Join("\n", pieces)),
+            cues.Skip(Math.Max(0, first - 2)).Take(Math.Min(2, first)).Select(c => Normalize(c.Text)).ToArray(),
+            cues.Skip(last + 1).Take(2).Select(c => Normalize(c.Text)).ToArray());
+    }
+
+    internal string? MatchChinese(IReadOnlyList<StudyCue> chinese)
+    {
+        var selected = chinese.Where(c => c.Start < End && c.End > Start
+                && c.Start >= Start - ChineseLead && c.End <= End + TimeSpan.FromMilliseconds(650))
+            .Where(c => c.Start + (c.End - c.Start) / 2 >= Start && c.Start + (c.End - c.Start) / 2 < End)
+            .Select(c => NormalizeForStudy(c.Text)).Where(t => t.Length > 0).ToArray();
+        return selected.Length == 0 ? null : string.Join("\n", selected);
+    }
+}
