--- /dev/null
+++ b/LLPlayer/Services/StudyPlaybackProgress.cs
@@ -0,0 +1,61 @@
+using System;
+using System.Globalization;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace LLPlayer.Services;
+
+internal sealed class StudyPlaybackProgress(string directory)
+{
+    internal static string? Key(string? input)
+    {
+        if (string.IsNullOrWhiteSpace(input)) return null;
+        if (!Path.IsPathFullyQualified(input) && Uri.TryCreate(input, UriKind.Absolute, out var uri) && uri.IsFile)
+            input = uri.LocalPath;
+        var extension = Path.GetExtension(input);
+        if (!string.Equals(extension, ".mkv", StringComparison.OrdinalIgnoreCase)
+            && !string.Equals(extension, ".mp4", StringComparison.OrdinalIgnoreCase)) return null;
+        var identity = StudySubtitleNotes.FileIdentity(input);
+        return identity is null ? null : Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(identity)));
+    }
+
+    internal long? Read(string key, long duration)
+    {
+        try
+        {
+            var file = new FileInfo(Entry(key));
+            if (!file.Exists || file.Length > 32) return null;
+            return long.TryParse(File.ReadAllText(file.FullName), NumberStyles.None, CultureInfo.InvariantCulture, out var ticks)
+                && ticks >= TimeSpan.TicksPerMillisecond && ticks < duration ? ticks : null;
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { return null; }
+    }
+
+    internal void Save(string key, long position, long duration, bool ended)
+    {
+        if (duration <= 0 || position < 0 || (!ended && position >= duration)) return;
+        var temp = Path.Combine(directory, Guid.NewGuid().ToString("N") + ".tmp");
+        bool created = false;
+        try
+        {
+            Directory.CreateDirectory(directory);
+            using (var output = File.Open(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None))
+            {
+                created = true;
+                output.Write(Encoding.ASCII.GetBytes((ended ? 0 : position).ToString(CultureInfo.InvariantCulture)));
+                output.Flush(flushToDisk: true);
+            }
+            File.Move(temp, Entry(key), overwrite: true);
+            created = false;
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+        finally
+        {
+            try { if (created) File.Delete(temp); }
+            catch (Exception error) when (error is IOException or UnauthorizedAccessException) { }
+        }
+    }
+
+    private string Entry(string key) => Path.Combine(directory, key + ".position");
+}
