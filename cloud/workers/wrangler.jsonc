{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "private-voice-review",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "LIBRARY", "class_name": "PrivateLibrary" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PrivateLibrary"] }],
  "build": { "command": "node prepare-wasm.mjs" },
  "observability": { "enabled": false }
}
