<Window x:Class="OriginalReview.CardEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="单词卡" Width="570" SizeToContent="Height"
    MaxHeight="650" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="18">
    <Label Target="{Binding ElementName=Word}">单词或表达</Label>
    <TextBox x:Name="Word" MaxLength="120" Padding="5" TextChanged="WordChanged" />
    <DockPanel>
      <Button x:Name="DictionaryButton" DockPanel.Dock="Right" Content="查本地词典" Click="FindDictionary" Padding="8,3" Margin="0,3,0,0" />
      <Label Target="{Binding ElementName=Meaning}">释义 / 本句义</Label>
    </DockPanel>
    <TextBox x:Name="Meaning" MaxLength="400" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="90" VerticalScrollBarVisibility="Auto" />
    <TextBox x:Name="DictionaryResult" IsReadOnly="True" Visibility="Collapsed" Padding="5" Margin="0,5,0,0"
      TextWrapping="Wrap" MaxHeight="104" VerticalScrollBarVisibility="Auto" />
    <Label Target="{Binding ElementName=English}">英文原句</Label>
    <TextBox x:Name="English" MaxLength="1000" Padding="5" TextWrapping="Wrap" />
    <Label Target="{Binding ElementName=Chinese}">整句中文</Label>
    <TextBox x:Name="Chinese" MaxLength="1000" Padding="5" TextWrapping="Wrap" />
    <StackPanel x:Name="AudioFields" Margin="0,12,0,0">
      <DockPanel>
        <Button Content="选原声片段" Click="PickAudio" Padding="9,4" Margin="0,0,8,0" />
        <Button x:Name="PreviewButton" Content="试听" Click="PreviewAudio" Padding="9,4" Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="ClearButton" Content="清除" Click="ClearAudio" Padding="9,4" Margin="0,0,8,0" IsEnabled="False" />
        <TextBlock x:Name="ClipName" Text="未选原声" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
      <CheckBox x:Name="Verified" Content="已重听，原句与原声一致" IsEnabled="False" Margin="0,10,0,0" />
    </StackPanel>
    <TextBlock x:Name="Feedback" Foreground="#A62020" TextWrapping="Wrap" Margin="0,10,0,6" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Padding="14,5" Margin="0,0,8,0" />
      <Button Content="保存" IsDefault="True" Click="Save" Padding="14,5" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
